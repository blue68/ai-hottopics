# Server
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
AUTO_REFRESH=true
INITIAL_REFRESH=true
SOURCE_CONCURRENCY=4
MAX_BODY_BYTES=1048576
MUTATION_RATE_LIMIT=30

# Required when HOST is not loopback. The browser build uses VITE_ADMIN_TOKEN
# to authenticate API requests. For multi-user deployments, prefer a reverse
# proxy with per-user authentication instead of embedding a shared token.
REQUIRE_AUTH=false
ADMIN_TOKEN=
VITE_ADMIN_TOKEN=

# Runtime defaults. These are also editable in the UI settings page.
REFRESH_INTERVAL_MINUTES=10
HEAT_THRESHOLD=72
TRACK_KEYWORDS=AI,OpenAI,Bitcoin,crypto,芯片,电动车,地缘政治,robot,agent
BLOCKED_WORDS=广告,招聘,水贴,博彩,返利

# Optional X/Twitter recent search source.
# Create a developer app and set a Bearer Token from the X API dashboard.
# These fields can also be saved from the UI settings page.
TWITTER_ENABLED=false
X_BEARER_TOKEN=
# Optional override for the X Recent Search query. When empty, TRACK_KEYWORDS are joined with OR.
X_SEARCH_QUERY=
# Optional ISO-like language filter, for example en or zh. Leave empty for all languages.
X_SEARCH_LANG=
# X API supports 10-100 results per Recent Search request.
X_SEARCH_MAX_RESULTS=50
# Default 512 is compatible with common self-serve access. Raise only if your X API tier supports it.
X_SEARCH_QUERY_MAX_CHARS=512

# Optional Weibo hot-search source via RSSHub-compatible RSS.
# For production, prefer a reliable self-hosted RSSHub instance.
# These fields can also be saved from the UI settings page.
WEIBO_ENABLED=true
WEIBO_MODE=auto
RSSHUB_BASE_URL=https://rsshub.app
WEIBO_RSS_URL=

# Optional source-specific tuning, also available in the UI settings page.
GITHUB_TOKEN=
REDDIT_USER_AGENT=ai-hottopics/0.1 (+local research dashboard)

# Optional short-video/social RSS sources. Configure a public RSS/RSSHub route before enabling.
TIKTOK_ENABLED=false
TIKTOK_RSS_URL=
TIKTOK_SOURCE_NAME=TikTok RSS
INSTAGRAM_ENABLED=false
INSTAGRAM_RSS_URL=
INSTAGRAM_SOURCE_NAME=Instagram RSS

# AI category sources
HUGGINGFACE_ENABLED=true
HUGGINGFACE_RSS_URL=https://huggingface.co/blog/feed.xml
HUGGINGFACE_SOURCE_NAME=Hugging Face Blog
OPENAI_BLOG_ENABLED=true
OPENAI_BLOG_RSS_URL=https://openai.com/news/rss.xml
OPENAI_BLOG_SOURCE_NAME=OpenAI News
DEEPMIND_ENABLED=true
DEEPMIND_RSS_URL=https://deepmind.google/blog/rss.xml
DEEPMIND_SOURCE_NAME=Google DeepMind Blog
ANTHROPIC_ENABLED=true
ANTHROPIC_RSS_URL=https://www.anthropic.com/news/rss.xml
ANTHROPIC_SOURCE_NAME=Anthropic News

# Crypto category sources
GLASSNODE_ENABLED=false
GLASSNODE_API_KEY=
GLASSNODE_ASSET=BTC
GLASSNODE_METRIC=market/price_usd_close
GLASSNODE_INTERVAL=24h
COINMARKETCAP_ENABLED=false
COINMARKETCAP_API_KEY=
COINMARKETCAP_ENDPOINT=https://pro-api.coinmarketcap.com/v1/cryptocurrency/trending/latest

# Life/knowledge category sources
WIKIPEDIA_ENABLED=true
WIKIPEDIA_LANGUAGE=zh
WIKIPEDIA_SOURCE_NAME=Wikipedia Featured
YOUTUBE_ENABLED=false
YOUTUBE_RSS_URL=
YOUTUBE_SOURCE_NAME=YouTube RSS

# Optional Telegram push integration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Feishu bot push integration
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
