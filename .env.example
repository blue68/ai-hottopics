# Server
PORT=8787
DATA_DIR=./data
AUTO_REFRESH=true
INITIAL_REFRESH=true

# Runtime defaults. These are also editable in the UI settings page.
REFRESH_INTERVAL_MINUTES=10
HEAT_THRESHOLD=72
TRACK_KEYWORDS=AI,OpenAI,Bitcoin,crypto,芯片,电动车,地缘政治,robot,agent
BLOCKED_WORDS=广告,招聘,水贴,博彩,返利

# Optional X/Twitter recent search source.
# Create a developer app and set a Bearer Token from the X API dashboard.
# These fields can also be saved from the UI settings page.
TWITTER_ENABLED=false
X_BEARER_TOKEN=
# Optional override for the X Recent Search query. When empty, TRACK_KEYWORDS are joined with OR.
X_SEARCH_QUERY=
# Optional ISO-like language filter, for example en or zh. Leave empty for all languages.
X_SEARCH_LANG=
# X API supports 10-100 results per Recent Search request.
X_SEARCH_MAX_RESULTS=50
# Default 512 is compatible with common self-serve access. Raise only if your X API tier supports it.
X_SEARCH_QUERY_MAX_CHARS=512

# Optional Weibo hot-search source via RSSHub-compatible RSS.
# For production, prefer a reliable self-hosted RSSHub instance.
# These fields can also be saved from the UI settings page.
WEIBO_ENABLED=true
WEIBO_MODE=auto
RSSHUB_BASE_URL=https://rsshub.app
WEIBO_RSS_URL=

# Optional source-specific tuning, also available in the UI settings page.
GITHUB_TOKEN=
REDDIT_USER_AGENT=ai-hottopics/0.1 (+local research dashboard)

# Optional Telegram push integration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Feishu bot push integration
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
