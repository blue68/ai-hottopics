{
  "name": "ai-hottopics",
  "description": "Open-source hot topic tracking, analysis, content generation, and push workflow.",
  "private": false,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "hot-topics",
    "trend-monitoring",
    "social-listening",
    "content-generation",
    "osint",
    "react",
    "vite"
  ],
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "api": "node --watch server/index.js",
    "check": "tsc -b && node --check server/index.js",
    "build": "tsc -b && vite build",
    "smoke": "node scripts/smoke-test.mjs",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "clean": "rm -rf dist .playwright-mcp *.tsbuildinfo"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.2"
  }
}
